---
// Ajustes del deletreo y ayuda rápida. Va bajo la cámara; lo controla features/deletreo.ts.
import Eyebrow from "../ui/Eyebrow.astro";
import Select from "../ui/Select.astro";
import Switch from "../ui/Switch.astro";

const velocidades = [
  { value: "1300", label: "lenta · 1,3 s" },
  { value: "900", label: "normal · 0,9 s" },
  { value: "600", label: "rápida · 0,6 s" },
];
const kbd = "rounded border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[11px] text-muted";
const consejos = [
  ["Dos manos", "Se leen las dos; escribe la que hace la letra más clara."],
  ["Letras dobles", "Para LL o RR, baja la mano un momento y repite."],
  ["J, Ñ, Z y tildes", "No se pueden hacer quietas: salen en las sugerencias."],
];
---
<section data-ajustes class="panel grid gap-5 p-5 md:grid-cols-[1fr_1.15fr]">
  <div class="space-y-4">
    <Eyebrow>Ajustes del deletreo</Eyebrow>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <span class="label-mono flex items-center gap-2">
        mantener
        <Select name="speed" label="Tiempo para escribir una letra" options={velocidades} value="900" />
      </span>
      <Switch data-autospace checked label="espacio al bajar la mano" />
    </div>
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[12.5px] text-dim">
      <span class="flex items-center gap-1.5"><kbd class={kbd}>Espacio</kbd>espacio</span>
      <span class="flex items-center gap-1.5"><kbd class={kbd}>⌫</kbd>borrar</span>
      <span class="flex items-center gap-1.5"><kbd class={kbd}>Tab</kbd>sugerencia</span>
      <span class="flex items-center gap-1.5"><kbd class={kbd}>Enter</kbd>leer</span>
    </p>
  </div>
  <ul class="space-y-2.5 border-line md:border-l md:pl-5">
    {consejos.map(([t, d]) => (
      <li class="text-[13px] leading-snug">
        <span class="font-medium text-fg">{t}.</span> <span class="text-muted">{d}</span>
      </li>
    ))}
  </ul>
</section>
