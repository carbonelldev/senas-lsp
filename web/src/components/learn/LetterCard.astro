---
interface Props { letra: string; como: string; ojo?: string }
const { letra, como, ojo } = Astro.props;
---
<li id={`letra-${letra}`} data-card={letra} class="panel spot reveal group flex scroll-mt-24 flex-col gap-4 p-4 transition-[border-color] duration-500 data-[learned]:border-ok/40">
  <div class="flex items-center justify-between">
    <span class="text-4xl font-semibold leading-none tracking-tight">{letra}</span>
    <span class="check label-mono inline-flex items-center gap-1.5 text-ok opacity-0 transition-opacity group-data-[learned]:opacity-100">
      <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8.5 3 3 7-7" /></svg>
      aprendida
    </span>
  </div>

  <div class="grid grid-cols-3 gap-2">
    <img src={`/ejemplos/${letra}_1.jpg`} alt={`Letra ${letra}, ejemplo 1`} width="100" height="100" loading="lazy" decoding="async" class="aspect-square w-full rounded-lg border border-line object-cover" />
    <img src={`/ejemplos/${letra}_2.jpg`} alt={`Letra ${letra}, ejemplo 2`} width="100" height="100" loading="lazy" decoding="async" class="aspect-square w-full rounded-lg border border-line object-cover" />
    <canvas data-skeleton={letra} class="aspect-square w-full rounded-lg border border-line bg-black/40" aria-label={`Esqueleto de la ${letra}`}></canvas>
  </div>

  <p class="text-[14px] leading-relaxed text-muted">{como}</p>
  {ojo && <p class="border-l-2 border-warn/70 pl-3 text-[12.5px] leading-relaxed text-dim">{ojo}</p>}

  <button data-practicar={letra} class="mt-auto inline-flex h-8 w-fit items-center gap-1.5 rounded-full border border-line-2 bg-panel-2 px-3 text-[13px] font-medium text-fg transition-colors hover:border-dim">
    Practicar
    <span class="transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5">→</span>
  </button>
</li>
