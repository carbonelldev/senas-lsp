---
import Logo from "./Logo.astro";
---
<footer class="relative z-10 border-t border-line/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex items-center gap-2.5 text-sm text-muted">
      <Logo class="size-5" />
      <span><span class="text-fg">deletrea</span> · alfabeto manual de la Lengua de Señas Peruana (LSP)</span>
    </div>
    <p class="label-mono flex flex-wrap gap-x-4 gap-y-2">
      <span>astro</span><span>mediapipe</span><span>red neuronal</span><span>cloudflare workers</span>
    </p>
  </div>
</footer>
