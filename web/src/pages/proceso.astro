---
// De Orange a la página, contado como una presentación corta (portada + 5 pasos, ~5 minutos).
// Se navega con scroll o con ← → (features/proceso.ts); "Presentar" pone la página a pantalla completa.
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import Paso from "../components/proceso/Paso.astro";
import Captura from "../components/proceso/Captura.astro";
import Termino from "../components/proceso/Termino.astro";
import { ORANGE, REPO, WEB } from "../data/proceso";
import modelo from "../../public/model/puntos.json";

// redondeo "de toda la vida" (0,7595 → 76,0 %), igual que en el informe; toFixed daría 75,9
const redondear = (v: number, dec = 1) => Math.round(Number((v * 100 * 10 ** dec).toFixed(6))) / 10 ** dec; // toFixed(6) evita 759,4999…
const pct = (v: number, dec = 1) => `${redondear(v, dec).toFixed(dec).replace(".", ",")} %`;
const M = modelo.metrics;
const capas = modelo.layers.slice(0, -1).map((l) => l.W[0].length); // [128, 64]
const N = modelo.mean.length;
const caracteristicas = [
  [60, "coordenadas", "20 puntos × (x, y, z)"],
  [10, "distancias", "entre las puntas de los dedos"],
  [15, "ángulos", "cuánto se dobla cada articulación"],
  [4, "aperturas", "entre dedos vecinos"],
  [6, "del pulgar", "a la base de los otros dedos"],
] as const;
const resultados = [
  ["Orange · foto entera · otro fondo", ORANGE.fondo, "text-bad", "bg-bad"],
  ["Página · puntos de la mano · otro fondo", M.newBackground, "text-ok", "bg-ok"],
  ["Página · mano girada hasta 35°", M.newAngle, "text-fg", "bg-accent"],
] as const;
const flecha = "shrink-0 text-dim";
const chip = "rounded-lg border border-line bg-panel-2 px-2.5 py-1.5 text-[12.5px] leading-tight text-fg";
---
<Base title="Proceso" description="De Orange a la página en cinco pasos: el problema del fondo, MediaPipe, qué analiza ahora el modelo, cuánto mejoró y cómo funciona la web." active="proceso" estado={false}>
  <div data-proceso>

    <!-- portada -->
    <section id="paso-0" data-slide data-titulo="Inicio" class="grid scroll-mt-14 items-center gap-10 pt-12 pb-16 lg:min-h-[calc(100dvh-3.5rem)] lg:grid-cols-[1.1fr_1fr] lg:py-10">
      <div class="flex flex-col gap-6">
        <Eyebrow class="animate-blur-in">Proceso · de Orange a la página</Eyebrow>
        <h1 class="text-4xl font-semibold tracking-tight text-balance animate-blur-in [animation-delay:80ms] sm:text-6xl sm:leading-[1.02]">
          De un 96 % que engañaba a una web que <span class="text-gradient">sí mira la mano</span>.
        </h1>
        <p class="max-w-xl text-[15px] leading-relaxed text-muted animate-blur-in [animation-delay:160ms] sm:text-lg">
          En cinco pasos: qué falló en Orange, qué cambiamos, qué analiza ahora el modelo, cuánto mejoró y cómo funciona la página.
        </p>
        <div class="flex flex-wrap items-center gap-3 animate-blur-in [animation-delay:240ms]">
          <Button as="a" href="#paso-1" variant="primary" size="lg">Empezar</Button>
          <Button size="lg" data-presentar>
            <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4" /></svg>
            <span data-presentar-texto>Presentar</span>
          </Button>
        </div>
        <p class="label-mono animate-blur-in [animation-delay:300ms]">← → para avanzar · Esc para salir</p>
      </div>
      <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_auto] items-center gap-2 animate-blur-in [animation-delay:200ms] sm:gap-3">
        <figure class="panel p-1.5">
          <img src="/proceso/foto_wall.jpg" alt="Foto de una mano haciendo la letra Y" width="480" height="480" class="aspect-square w-full rounded-[10px]" />
          <figcaption class="label-mono px-1 pt-2.5 pb-1">la foto</figcaption>
        </figure>
        <span class={flecha}>→</span>
        <figure class="panel p-1.5">
          <img src="/proceso/puntos_wall.jpg" alt="La misma foto con los 21 puntos de la mano marcados" width="480" height="480" class="aspect-square w-full rounded-[10px]" />
          <figcaption class="label-mono px-1 pt-2.5 pb-1">21 puntos</figcaption>
        </figure>
        <span class={flecha}>→</span>
        <div class="panel grid aspect-square w-16 place-items-center sm:w-24">
          <span class="text-gradient text-4xl font-semibold sm:text-6xl">Y</span>
        </div>
      </div>
    </section>

    <!-- 1 · Orange y el problema del fondo -->
    <Paso n={1} etiqueta="Orange" titulo="Acertaba el 96 %, pero miraba el fondo">
      <p>En Orange, con Inception v3 y Test and Score, Logistic Regression acertó el <strong class="font-medium text-fg">{pct(ORANGE.cv)}</strong>.</p>
      <p>Pero al entrenar con un fondo y probar con el otro (<span class="text-fg">Cross validation by feature</span>), bajó a <strong class="font-medium text-bad">{pct(ORANGE.fondo)}</strong>.</p>
      <Termino termino="Aprendizaje por atajos" ingles="shortcut learning">
        El modelo usó una pista fácil, el fondo, en vez de aprender la forma de la mano.
      </Termino>
      <div slot="visual" class="flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-3">
          <Captura src="/proceso/foto_library.jpg" alt="Letra Y con fondo de biblioteca" ancho={480} alto={480} pie="Letra Y · fondo biblioteca" />
          <Captura src="/proceso/foto_wall.jpg" alt="Letra Y con fondo de pared" ancho={480} alto={480} pie="Letra Y · fondo pared" />
        </div>
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
          <div class="panel flex flex-col gap-1 px-5 py-4">
            <span class="label-mono">mismos fondos</span>
            <span class="text-4xl font-medium tracking-tight tabular sm:text-5xl" data-count={redondear(ORANGE.cv)} data-decimals="1" data-suffix=" %">0</span>
          </div>
          <span class={flecha}>→</span>
          <div class="panel flex flex-col gap-1 border-bad/40 px-5 py-4">
            <span class="label-mono">otro fondo</span>
            <span class="text-4xl font-medium tracking-tight text-bad tabular sm:text-5xl" data-count={redondear(ORANGE.fondo)} data-decimals="1" data-suffix=" %">0</span>
          </div>
        </div>
      </div>
    </Paso>

    <!-- 2 · el cambio: MediaPipe -->
    <Paso n={2} etiqueta="El cambio" titulo="Dejamos la foto entera y miramos solo la mano">
      <p>Usamos <strong class="font-medium text-fg">MediaPipe Hand Landmarker</strong>, un modelo de Google ya entrenado: primero encuentra la palma y luego marca <strong class="font-medium text-fg">21 puntos</strong> (muñeca, nudillos, articulaciones y puntas de los dedos).</p>
      <p>El fondo ya no le llega al modelo, así que no lo puede usar de atajo.</p>
      <div slot="visual" class="flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-3">
          <Captura src="/proceso/puntos_library.jpg" alt="Los 21 puntos de la mano sobre la foto con fondo de biblioteca" ancho={480} alto={480} pie="fondo biblioteca" />
          <Captura src="/proceso/puntos_wall.jpg" alt="Los 21 puntos de la mano sobre la foto con fondo de pared" ancho={480} alto={480} pie="fondo pared" />
        </div>
        <div class="panel flex flex-col gap-3 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="label-mono w-14 text-bad">antes</span>
            <span class={chip}>foto</span><span class={flecha}>→</span><span class={chip}>Inception v3</span><span class={flecha}>→</span>
            <span class={chip}>2048 números <span class="text-dim">· mano + fondo</span></span>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="label-mono w-14 text-ok">ahora</span>
            <span class={chip}>foto</span><span class={flecha}>→</span><span class={chip}>MediaPipe</span><span class={flecha}>→</span>
            <span class={chip}>21 puntos <span class="text-dim">· solo la mano</span></span>
          </div>
        </div>
      </div>
    </Paso>

    <!-- 3 · qué analiza ahora -->
    <Paso n={3} etiqueta="Qué analiza" titulo={`Ahora analiza la forma de la mano: ${N} números`}>
      <p>Los puntos se acomodan: la muñeca va al centro y la palma mide 1. Así da igual dónde esté la mano o qué tan cerca de la cámara.</p>
      <p>Con eso se calculan distancias y ángulos entre los dedos, y una <strong class="font-medium text-fg">Neural Network</strong> ({capas.join(" y ")} neuronas, entrenada en Python) decide la letra.</p>
      <div slot="visual" class="grid gap-3 sm:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]">
        <div class="inset-panel dots-bg relative aspect-square w-full overflow-hidden sm:aspect-auto sm:min-h-full">
          <canvas data-skeleton="Y" class="absolute inset-0 h-full w-full"></canvas>
          <span class="label-mono absolute top-3 left-3">letra Y · normalizada</span>
        </div>
        <div class="panel flex flex-col p-1.5">
          <ul class="flex flex-col divide-y divide-line">
            {caracteristicas.map(([n, t, d]) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3 px-3 py-3">
                <span class="text-right font-mono text-2xl leading-none text-fg tabular">{n}</span>
                <span class="flex flex-col gap-1 text-[13px] leading-tight">
                  <span class="font-medium text-fg">{t}</span>
                  <span class="text-dim">{d}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="mt-1.5 grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3 rounded-[10px] bg-white/[0.04] px-3 py-3">
            <span class="text-right font-mono text-2xl leading-none text-accent tabular">{N}</span>
            <span class="label-mono">en total, por cada foto</span>
          </div>
        </div>
      </div>
    </Paso>

    <!-- 4 · cuánto mejoró -->
    <Paso n={4} etiqueta="Cuánto mejoró" titulo={`Con otro fondo, de ${pct(ORANGE.fondo)} a ${pct(M.newBackground)}`}>
      <p>Comparamos en Python los mismos cuatro modelos que en Orange y la Neural Network dio el mejor equilibrio. En cross-validation acierta el {pct(M.cv10)}.</p>
      <Termino termino="Aumento de datos" ingles="data augmentation">
        Al entrenar, cada mano se copia girada y espejada. Así reconoce la mano inclinada, de costado o la otra mano.
      </Termino>
      <div slot="visual" class="flex flex-col gap-3">
        <dl class="panel flex flex-col gap-6 p-6 sm:p-7">
          {resultados.map(([t, v, texto, barra]) => (
            <div class="flex flex-col gap-2">
              <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
                <dt class="label-mono leading-snug">{t}</dt>
                <dd class:list={["text-4xl font-medium tracking-tight whitespace-nowrap tabular sm:text-5xl", texto]} data-count={redondear(v)} data-decimals="1" data-suffix=" %">0</dd>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-line"><div class:list={["h-full rounded-full", barra]} style={`width: ${v * 100}%`}></div></div>
            </div>
          ))}
        </dl>
        <div class="grid grid-cols-4 gap-2">
          {[["original", 0, false], ["girada −30°", -30, false], ["girada +30°", 30, false], ["espejada", 0, true]].map(([t, rot, esp]) => (
            <figure class="inset-panel dots-bg flex flex-col overflow-hidden">
              <div class="relative aspect-[4/3] w-full"><canvas data-mano="Y" data-rot={rot} data-espejo={esp ? "" : undefined} class="absolute inset-0 h-full w-full"></canvas></div>
              <figcaption class="label-mono px-2 pb-2.5 text-center">{t}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </Paso>

    <!-- 5 · la página -->
    <Paso n={5} etiqueta="La página" titulo="Funciona en vivo, en el navegador">
      <p>La cámara pasa por MediaPipe, la Neural Network da la letra y, si mantienes la seña, se escribe. También lee dos manos y tiene una sección para aprender el alfabeto.</p>
      <p>Todo corre en la computadora de quien la usa: <strong class="font-medium text-fg">la imagen no se envía a ningún servidor</strong>.</p>
      <p class="text-[14px] text-dim">Hecha con Astro y TypeScript, con ayuda de Claude Code (declarado en el informe). Código en GitHub.</p>
      <div class="flex flex-wrap gap-2 pt-1">
        <Button as="a" href="/" variant="primary">Probar el detector</Button>
        <Button as="a" href={REPO.url} target="_blank" rel="noopener">Ver en GitHub ↗</Button>
      </div>
      <div slot="visual" class="flex flex-col gap-3">
        <ol class="grid grid-cols-3 gap-2">
          {[
            ["Cámara", "cada fotograma"],
            ["MediaPipe", "21 puntos"],
            [`${N} números`, "forma de la mano"],
            ["Neural Network", "probabilidad por letra"],
            ["Letra", "en pantalla"],
            ["Palabra", "al mantener la seña"],
          ].map(([t, d], i, a) => (
            <li class:list={["inset-panel flex flex-col gap-1 px-3 py-2.5", i === a.length - 1 && "border-accent/50"]}>
              <span class="flex items-center gap-2 text-[13px] font-medium text-fg">
                <span class="font-mono text-[10.5px] text-dim">{i + 1}</span>{t}
              </span>
              <span class="text-[11.5px] leading-tight text-dim">{d}</span>
            </li>
          ))}
        </ol>
        <Captura src={WEB.capturaDetector.src} alt="La página reconociendo la letra Y con los puntos de la mano" ancho={WEB.capturaDetector.ancho} alto={WEB.capturaDetector.alto} pie="El detector: puntos de la mano, letra, confianza y la palabra que se va escribiendo" />
      </div>
    </Paso>

    <!-- navegación de la presentación -->
    <nav data-puntos aria-label="Pasos" class="fixed top-1/2 right-4 z-30 hidden -translate-y-1/2 flex-col items-center gap-2.5 xl:flex"></nav>
    <div class="fixed bottom-4 left-1/2 z-30 flex -translate-x-1/2 items-center gap-1 rounded-full border border-line bg-bg/80 p-1 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.9)] backdrop-blur-xl">
      <button type="button" data-anterior aria-label="Paso anterior" class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:bg-white/5 hover:text-fg disabled:opacity-30">←</button>
      <span data-contador class="min-w-16 text-center font-mono text-[12px] text-muted tabular">00 / 05</span>
      <button type="button" data-siguiente aria-label="Paso siguiente" class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:bg-white/5 hover:text-fg disabled:opacity-30">→</button>
      <span class="mx-1 h-4 w-px bg-line-2"></span>
      <button type="button" data-presentar data-tip="Pantalla completa · ← → para avanzar · Esc para salir" class="flex h-8 items-center gap-1.5 rounded-full px-3 text-[12.5px] font-medium text-muted transition-colors hover:bg-white/5 hover:text-fg">
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4" /></svg>
        <span data-presentar-texto>Presentar</span>
      </button>
    </div>
  </div>

  <script>
    import { enPagina } from "../lib/pagina";
    import { montarProceso } from "../features/proceso";
    enPagina("[data-proceso]", montarProceso);
  </script>
</Base>
