---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import Confusion from "../components/project/Confusion.astro";
import PorLetra from "../components/project/PorLetra.astro";
import { DATASET, FASES, LIMITACIONES, PROYECTO, STACK } from "../data/proyecto";
import { LETRAS } from "../data/letras";
import ev from "../../public/model/evaluacion.json";
import modelo from "../../public/model/puntos.json";

const pct = (v: number, dec = 0) => `${(v * 100).toFixed(dec).replace(".", ",")} %`;
const cabecera = [PROYECTO.asignatura, PROYECTO.universidad, PROYECTO.curso].filter(Boolean).join(" · ");
const secciones = [
  ["resumen", "Resumen"],
  ["datos", "Datos"],
  ["metodo", "Método"],
  ["resultados", "Resultados"],
  ["limitaciones", "Limitaciones"],
  ["reproducir", "Reproducir"],
];
---
<Base title="Proyecto" description="Memoria del proyecto: dataset, método, resultados con matriz de confusión, limitaciones y cómo reproducirlo." active="proyecto" estado={false}>
  <section class="space-y-14 pt-12 sm:pt-16">

    <!-- cabecera -->
    <header class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div class="flex flex-col gap-5">
        <Eyebrow class="animate-blur-in">Memoria del proyecto{cabecera && ` · ${cabecera}`}</Eyebrow>
        <h1 class="text-4xl font-semibold tracking-tight text-balance animate-blur-in [animation-delay:80ms] sm:text-5xl sm:leading-[1.05]">
          {PROYECTO.titulo}
        </h1>
        <p class="max-w-2xl text-[15px] leading-relaxed text-muted animate-blur-in [animation-delay:160ms] sm:text-lg">
          Un clasificador de las 24 letras estáticas del alfabeto manual de la Lengua de Señas Peruana (LSP) que corre en el navegador. Lo interesante no es el acierto final, sino el camino:
          el primer modelo parecía casi perfecto y en realidad no miraba la mano.
        </p>
        {PROYECTO.autores.length > 0 && (
          <p class="label-mono animate-blur-in [animation-delay:220ms]">{PROYECTO.autores.join(" · ")}</p>
        )}
      </div>
      <nav aria-label="Secciones de la memoria" class="panel flex flex-wrap gap-1 p-2 animate-blur-in [animation-delay:200ms] lg:justify-self-end">
        {secciones.map(([id, t]) => (
          <a href={`#${id}`} class="rounded-full px-3 py-1.5 text-[13px] font-medium text-muted transition-colors hover:bg-white/5 hover:text-fg">{t}</a>
        ))}
      </nav>
    </header>

    <!-- resumen -->
    <section id="resumen" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Resumen</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">Tres números que cuentan la historia.</h2>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3">
        <div class="reveal flex flex-col gap-1 bg-panel p-5" style="--i: 0">
          <dt class="label-mono">Orange · píxeles · validación cruzada</dt>
          <dd class="text-4xl font-medium tracking-tight sm:text-5xl" data-count="96.4" data-decimals="1" data-suffix=" %">0</dd>
          <dd class="text-[13px] text-dim">Parecía resuelto.</dd>
        </div>
        <div class="reveal flex flex-col gap-1 bg-panel p-5" style="--i: 1">
          <dt class="label-mono">píxeles · fondo nuevo</dt>
          <dd class="text-4xl font-medium tracking-tight text-bad sm:text-5xl" data-count="22.1" data-decimals="1" data-suffix=" %">0</dd>
          <dd class="text-[13px] text-dim">Aprendía el fondo, no la mano.</dd>
        </div>
        <div class="reveal flex flex-col gap-1 bg-panel p-5" style="--i: 2">
          <dt class="label-mono">puntos de la mano · fondo nuevo</dt>
          <dd class="text-4xl font-medium tracking-tight text-ok sm:text-5xl" data-count={ev.fondoNuevo * 100} data-decimals="1" data-suffix=" %">0</dd>
          <dd class="text-[13px] text-dim">El modelo que corre aquí.</dd>
        </div>
      </dl>
      <p class="reveal max-w-3xl text-[15px] leading-relaxed text-muted">
        <strong class="font-medium text-fg">Objetivo.</strong> Reconocer en tiempo real la letra que una persona hace con la mano, sin enviar vídeo a ningún servidor.{" "}
        <strong class="font-medium text-fg">Resultado.</strong> Un modelo pequeño (regresión logística sobre 21 puntos de la mano) con {pct(ev.cv10, 1)} de acierto en validación cruzada y {pct(ev.fondoNuevo, 1)} cuando el fondo es nuevo,
        integrado en una web que detecta, enseña y permite practicar las 24 letras.
      </p>
    </section>

    <!-- datos -->
    <section id="datos" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Datos</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">{DATASET.fotos} fotos, una mano, dos fondos.</h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-[1fr_1.4fr]">
        <dl class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line">
          {[
            ["fotos", String(DATASET.fotos)],
            ["letras", `${DATASET.letras} (sin J, Ñ ni Z)`],
            ["por letra", `${DATASET.porLetra} fotos`],
            ["fondos", `${DATASET.fondos.join(" y ")} · ${DATASET.porFondo} cada uno`],
            ["tamaño", DATASET.tamano],
            ["con mano detectada", `${ev.n} (${pct(modelo.metrics.detected, 1)})`],
          ].map(([k, v]) => (
            <div class="bg-panel p-4">
              <dt class="label-mono mb-1">{k}</dt>
              <dd class="text-[15px] font-medium">{v}</dd>
            </div>
          ))}
        </dl>
        <div class="reveal panel p-4" style="--i: 1">
          <p class="mb-3 text-[13px] text-muted">Una foto por letra, fondo <span class="font-mono text-fg">library</span>. La fila de abajo, fondo <span class="font-mono text-fg">wall</span>.</p>
          <div class="grid grid-cols-8 gap-1.5 sm:grid-cols-12">
            {LETRAS.map((l) => <img src={`/ejemplos/${l.letra}_2.jpg`} alt={`Letra ${l.letra}, fondo library`} width="100" height="100" loading="lazy" decoding="async" class="aspect-square w-full rounded-md border border-line object-cover" />)}
            {LETRAS.map((l) => <img src={`/ejemplos/${l.letra}_1.jpg`} alt={`Letra ${l.letra}, fondo wall`} width="100" height="100" loading="lazy" decoding="async" class="aspect-square w-full rounded-md border border-line object-cover" />)}
          </div>
          <p class="mt-3 text-[12.5px] leading-relaxed text-dim">
            {DATASET.fuente}. Los archivos se renombraron de números a nombres de dos sílabas (<span class="font-mono">baba.jpg</span>, <span class="font-mono">babe.jpg</span>…) y el CSV lleva la cabecera de tres filas que Orange necesita para tratar la columna como imagen.
          </p>
        </div>
      </div>
    </section>

    <!-- metodo -->
    <section id="metodo" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Método</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">Tres intentos, una lección.</h2>
        <p class="max-w-2xl text-[15px] leading-relaxed text-muted">
          La misma receta de clasificación (regresión logística) con tres entradas distintas. Lo que cambia los resultados no es el modelo, sino qué se le da a ver.
        </p>
      </div>
      <ol class="grid gap-4 lg:grid-cols-3">
        {FASES.map((f, i) => (
          <li class:list={["panel spot reveal flex flex-col gap-4 p-5", i === 2 && "border-accent/40"]} style={`--i: ${i}`}>
            <div class="flex items-center justify-between">
              <span class="label-mono">{f.n} · {i === 2 ? "en uso" : "descartado"}</span>
              {i === 2 && <span class="size-1.5 rounded-full bg-ok shadow-[0_0_8px_var(--color-ok)]"></span>}
            </div>
            <h3 class="text-xl font-semibold tracking-tight">{f.titulo}</h3>
            <p class="font-mono text-[12px] leading-relaxed text-accent">{f.entrada}</p>
            <p class="text-[14px] leading-relaxed text-muted">{f.resumen}</p>
            <table class="text-[13px]">
              <tbody>
                {f.resultados.map((r) => (
                  <tr class="border-t border-line/70">
                    <td class="py-1.5 pr-3 text-muted">{r.modelo}</td>
                    <td class="py-1.5 text-right font-medium tabular">{pct(r.cv, 1)}</td>
                    {"auc" in r && <td class="py-1.5 pl-3 text-right tabular text-dim">AUC {r.auc}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-auto border-l-2 border-warn/70 pl-3 text-[13px] leading-relaxed text-muted">{f.leccion}</p>
          </li>
        ))}
      </ol>
      <div class="reveal panel grid gap-4 p-5 md:grid-cols-[auto_1fr] md:items-center">
        <div class="inset-panel relative aspect-square w-40 overflow-hidden">
          <canvas data-skeleton="L" class="absolute inset-0 h-full w-full"></canvas>
        </div>
        <div class="space-y-2 text-[14px] leading-relaxed text-muted">
          <p><strong class="font-medium text-fg">Características (70 números por foto).</strong> Los 21 puntos menos la muñeca, en 3D y normalizados (60 valores), más las 10 distancias entre las puntas de los dedos. Se estandarizan y entran en una regresión logística con regularización L2 (C = 1), igual que en Orange.</p>
          <p><strong class="font-medium text-fg">Aumento de datos.</strong> Cada mano se rota ±15°, se escala ±10 %, se le añade ruido y se espeja, para que el modelo funcione con la mano izquierda y con la cámara torcida.</p>
          <p><strong class="font-medium text-fg">Evaluación.</strong> Validación cruzada estratificada de 10 particiones y "fondo nuevo": entrenar con <span class="font-mono">library</span> y probar con <span class="font-mono">wall</span>, y al revés. Esta segunda prueba es la que se parece a usar otra cámara en otro sitio.</p>
        </div>
      </div>
    </section>

    <!-- resultados -->
    <section id="resultados" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Resultados</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">Dónde acierta y dónde se confunde.</h2>
        <p class="max-w-2xl text-[15px] leading-relaxed text-muted">
          Las letras con dedos extendidos (U, W, T, R, Y, X) se reconocen casi siempre. Los fallos se concentran en los puños (A, M, N, E) y en pares que solo cambian la orientación (P/Q, G/H).
        </p>
      </div>
      <Confusion />
      <PorLetra />
    </section>

    <!-- limitaciones -->
    <section id="limitaciones" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Limitaciones</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">Lo que este modelo no hace.</h2>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {LIMITACIONES.map((t, i) => (
          <li class="panel reveal flex gap-3 p-4 text-[14px] leading-relaxed text-muted" style={`--i: ${i}`}>
            <span class="label-mono mt-1 shrink-0 text-dim">{String(i + 1).padStart(2, "0")}</span>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      <p class="reveal max-w-3xl text-[14px] leading-relaxed text-muted">
        <strong class="font-medium text-fg">Siguientes pasos.</strong> Grabar fotos de más personas (varias manos y luces), añadir una ventana temporal para reconocer la J, la Ñ y la Z por su trayectoria, y comparar con un modelo pequeño entrenado directamente sobre los puntos (una red de dos capas) con datos de varias personas.
      </p>
    </section>

    <!-- reproducir -->
    <section id="reproducir" class="scroll-mt-20 space-y-6">
      <div class="reveal space-y-2">
        <Eyebrow>Reproducir</Eyebrow>
        <h2 class="text-3xl font-semibold tracking-tight">Todo el camino, en cuatro comandos.</h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-[1.3fr_1fr]">
        <pre class="reveal inset-panel overflow-x-auto p-5 font-mono text-[12.5px] leading-relaxed text-muted"><code><span class="text-dim"># fotos → 21 puntos por mano</span>
python extraer_puntos.py ../data
<span class="text-dim"># compara LR, SVM, red neuronal y kNN; exporta el mejor</span>
python entrenar_puntos.py ../web/public/model
<span class="text-dim"># matriz de confusión y acierto por letra</span>
python evaluar.py ../web/public/model/evaluacion.json
<span class="text-dim"># comprueba que el clasificador en JS da lo mismo que Python</span>
npm test</code></pre>
        <div class="reveal panel p-5" style="--i: 1">
          <p class="label-mono mb-3">herramientas</p>
          <ul class="space-y-2.5">
            {STACK.map((s) => (
              <li class="text-[13px] leading-snug"><span class="font-medium text-fg">{s.nombre}</span><br /><span class="text-muted">{s.uso}</span></li>
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap gap-2">
            <Button as="a" href="/" variant="primary" size="sm">Ver la demo</Button>
            <Button as="a" href="/aprender" size="sm">Practicar las letras</Button>
          </div>
        </div>
      </div>
    </section>
  </section>
</Base>
